# Copy to .env for local development. No secrets belong in this file.

# development | test | production
APP_ENV=development

# SQLAlchemy URL. Relative SQLite paths resolve from the backend/ directory.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# IANA timezone that defines the "learning day" (streak, daily XP) and the
# "learning week" (leaderboard). Timestamps are always stored in UTC.
APP_TIMEZONE=UTC

# Username of the seeded default learner returned by get_current_user().
DEFAULT_USERNAME=learner

# Enables POST /api/test/reset for Playwright. Never enable outside local testing.
ENABLE_TEST_ROUTES=false
