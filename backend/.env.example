# Copy to .env for local development. No secrets belong in this file.

# development | test | production
APP_ENV=development

# SQLAlchemy URL. Relative SQLite paths resolve from the backend/ directory.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# IANA timezone that defines the "learning day" (streak, daily XP) and the
# "learning week" (leaderboard). Timestamps are always stored in UTC.
APP_TIMEZONE=UTC

# Username given to the seeded learner.
DEFAULT_USERNAME=learner

# Signs session tokens. Set a long random value outside local development
# (the app refuses to start in production with the built-in default).
# SECRET_KEY=

# How long a login lasts, and the PBKDF2 work factor for new password hashes.
SESSION_DAYS=30
PASSWORD_ITERATIONS=210000

# Enables POST /api/auth/demo, which signs a visitor in as the seeded learner without a
# password. The frontend's /demo page uses it, so a demo can be shared as a single link.
ENABLE_DEMO_LOGIN=false

# Enables POST /api/test/reset for Playwright. Never enable outside local testing.
ENABLE_TEST_ROUTES=false
